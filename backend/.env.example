# Database connection
DATABASE_URL="postgresql://nexus_user:nexus_pass123@localhost:5433/nexus_academic"

# Authentication
JWT_SECRET="nexus-jwt-secret-change-in-production-2024"
JWT_REFRESH_SECRET="nexus-jwt-refresh-secret-change-in-production-2024"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Server configuration
PORT=3001
FRONTEND_URL="http://localhost:5500"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Embedded Postgres (Development)
EMBEDDED_PG_PORT=5433
EMBEDDED_PG_USER="nexus_user"
EMBEDDED_PG_PASS="nexus_pass123"
EMBEDDED_PG_DATA_DIR="./.postgres-data"
NODE_ENV="development"
